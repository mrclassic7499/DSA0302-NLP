      "source": [
        "# Trace Hobbs Algorithm & Centering Theory Transitions\n",
        "\n",
        "# Simulated Forward-Looking Centers (Cf) lists for 3 sentences\n",
        "cf_lists = [\n",
        "    [\"road\", \"Sector 4\"], # Sent 1: The road in Sector 4 is flooded.\n",
        "    [\"road\"],             # Sent 2: It is completely blocked.\n",
        "    [\"route\"]             # Sent 3: Avoid this route.\n",
        "]\n",
        "\n",
        "def run_centering_analysis(cf_history):\n",
        "    print(\"--- Centering Theory Transitions Trace ---\")\n",
        "    cb = None # Backward-Looking Center\n",
        "    for i, cf in enumerate(cf_history):\n",
        "        cp = cf[0] # Preferred Center\n",
        "        if i == 0:\n",
        "            cb = cp\n",
        "            print(f\"U1: Cf={cf}, Cb={cb}, Transition=Establish\")\n",
        "        else:\n",
        "            # Determine the current Cb (highest-ranked item in previous Cf that is in current Cf)\n",
        "            intersect = [item for item in cf if item in cf_history[i-1]]\n",
        "            current_cb = intersect[0] if intersect else None\n",
        "\n",
        "            if current_cb is None:\n",
        "                transition = \"Rough Shift\"\n",
        "            elif current_cb == cb:\n",
        "                transition = \"Continue\" if cp == current_cb else \"Retain\"\n",
        "            else:\n",
        "                transition = \"Smooth Shift\"\n",
        "\n",
        "            print(f\"U{i+1}: Cf={cf}, Cb={current_cb}, Cp={cp}, Transition={transition}\")\n",
        "            cb = current_cb\n",
        "\n",
        "run_centering_analysis(cf_lists)"
      ],
      "execution_count": 3,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "--- Centering Theory Transitions Trace ---\n",
            "U1: Cf=['road', 'Sector 4'], Cb=road, Transition=Establish\n",
            "U2: Cf=['road'], Cb=road, Cp=road, Transition=Continue\n",
            "U3: Cf=['route'], Cb=None, Cp=route, Transition=Rough Shift\n"
          ]
        }
      ]
