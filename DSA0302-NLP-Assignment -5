        "id": "189502e4",
        "outputId": "b9ed99ac-7c1c-4422-84c2-bcdf2a8e7ea3"
      },
      "source": [
        "# Task 12: Code-Mixed and Noisy Speech Transcript Pipeline Adaptations\n",
        "\n",
        "code_mixed_inputs = [\n",
        "    \"Sector 4 me road block hai because of heavy flooding.\",\n",
        "    \"Power failure hogaya main square ke paas, immediately help bhejo.\"\n",
        "]\n",
        "\n",
        "def clean_and_normalize_codemixed(text):\n",
        "    # Robust dictionary-based phrase and token-level normalizer\n",
        "    normalization_rules = {\n",
        "        \"block hai\": \"is blocked\",\n",
        "        \"hogaya\": \"occurred\",\n",
        "        \"me\": \"in\",\n",
        "        \"ke paas\": \"near\",\n",
        "        \"bhejo\": \"send\"\n",
        "    }\n",
        "\n",
        "    normalized_text = text\n",
        "    # Replace multi-word phrases first to preserve contexts\n",
        "    for foreign_phrase, english_phrase in sorted(normalization_rules.items(), key=lambda x: -len(x[0])):\n",
        "        normalized_text = normalized_text.replace(foreign_phrase, english_phrase)\n",
        "\n",
        "    # Normalize individual remaining particles\n",
        "    words = normalized_text.split()\n",
        "    cleaned_words = [normalization_rules.get(w, w) for w in words]\n",
        "    return \" \".join(cleaned_words)\n",
        "\n",
        "print(\"--- Task 12: Code-Mixed Speech Processing Normalization Output ---\")\n",
        "for raw_input in code_mixed_inputs:\n",
        "    normalized = clean_and_normalize_codemixed(raw_input)\n",
        "    print(f\"Raw Code-Mixed: '{raw_input}'\")\n",
        "    print(f\"Normalized English Representation: '{normalized}'\\n\")"
      ],
