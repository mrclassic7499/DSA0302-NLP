        "id": "1692d609",
        "outputId": "f7975e12-a82b-49bc-faad-581bf44edae4"
      },
      "source": [
        "# Task 9: Detailed EM Translation Algorithm Trace\n",
        "import collections\n",
        "\n",
        "# Parallel Corpus of Disaster Bulletin sentences\n",
        "parallel_data = [\n",
        "    (\"road flooded\", \"sadak jalamagna\"),\n",
        "    (\"avoid route\", \"marg bacho\"),\n",
        "    (\"power failure\", \"bijli gul\")\n",
        "]\n",
        "\n",
        "def train_ibm_model_1(corpus, iterations=5):\n",
        "    # Initialize uniform translation probabilities\n",
        "    t = collections.defaultdict(lambda: 0.5)\n",
        "    english_vocab = set()\n",
        "    foreign_vocab = set()\n",
        "\n",
        "    for eng, foreign in corpus:\n",
        "        for e_w in eng.split():\n",
        "            english_vocab.add(e_w)\n",
        "        for f_w in foreign.split():\n",
        "            foreign_vocab.add(f_w)\n",
        "\n",
        "    print(f\"Initial Vocabulary - English: {list(english_vocab)}, Regional: {list(foreign_vocab)}\")\n",
        "\n",
        "    # EM Iterations\n",
        "    for k in range(iterations):\n",
        "        count_ef = collections.defaultdict(float)\n",
        "        total_e = collections.defaultdict(float)\n",
        "\n",
        "        for eng, foreign in corpus:\n",
        "            e_words = eng.split()\n",
        "            f_words = foreign.split()\n",
        "\n",
        "            for f_w in f_words:\n",
        "                # Compute normalization denominator\n",
        "                s_total = sum(t[(e_w, f_w)] for e_w in e_words)\n",
        "                for e_w in e_words:\n",
        "                    c = t[(e_w, f_w)] / s_total\n",
        "                    count_ef[(e_w, f_w)] += c\n",
        "                    total_e[e_w] += c\n",
        "\n",
        "        # M-Step: Update translation parameters\n",
        "        for (e_w, f_w) in count_ef:\n",
        "            t[(e_w, f_w)] = count_ef[(e_w, f_w)] / total_e[e_w]\n",
        "\n",
        "        print(f\"Iteration {k+1} - Probability trace for ('road', 'sadak'): {t[('road', 'sadak')]:.4f}\")\n",
        "    return t\n",
        "\n",
        "translation_probabilities = train_ibm_model_1(parallel_data, iterations=3)"
      ],
