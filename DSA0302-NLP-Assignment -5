        "    def __init__(self):\n",
        "        self.slots = {\"caller_name\": None, \"location\": None, \"urgency\": None}\n",
        "\n",
        "    def fill_slots(self, text):\n",
        "        text_lower = text.lower()\n",
        "        if \"sector\" in text_lower:\n",
        "            self.slots[\"location\"] = \"Sector 4\"\n",
        "        if \"emergency\" in text_lower or \"immediate\" in text_lower:\n",
