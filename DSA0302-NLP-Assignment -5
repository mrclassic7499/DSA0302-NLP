        "# Simple template-free surface realizer with subject-verb-object synthesis\n",
        "def realize_sentence(subj, verb, obj, tense=\"present\"):\n",
        "    if tense == \"past\":\n",
        "        verb_form = verb + \"ed\" if not verb.endswith(\"ed\") else verb\n",
        "    else:\n",
        "        verb_form = verb + \"s\" if not verb.endswith(\"s\") else verb\n",
        "    return f\"{subj.capitalize()} {verb_form} {obj}.\"\n",
        "\n",
        "print(realize_sentence(\"flood water\", \"subside\", \"in Sector 4\", \"past\"))"
      ],
